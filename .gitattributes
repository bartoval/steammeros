# The Python scripts are development tools (export, reference, validation), not the library:
# keep them out of GitHub's language stats.
tools/*.py linguist-vendored linguist-detectable=false

# Show the Go package as the repository's primary language.
# The native C++ core remains part of the library, outside the language statistics.
src/** linguist-detectable=false
include/** linguist-detectable=false
include/*.h linguist-language=C++  # the C API header belongs to the C++ library
